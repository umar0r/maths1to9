        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "Direct proportion: when you times one amount by a number, you times the other amount by the same number."
                },
                {
                    "text": "Don't add. 2 more biscuits don't cost 2p more."
                },
                {
                    "text": "Find the value of 1 first: divide. Then times by how many you want."
                },
                {
                    "text": "Divide the right way round. For the price of 1 pen, it's pounds ÷ pens."
                },
                {
                    "text": "To test for direct proportion: 0 must give 0, and 1 must always cost the same."
                }
            ]
        }
    },
