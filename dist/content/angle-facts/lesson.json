            "title": "What you have learnt",
            "points": [
                {
                    "text": "Angles on a straight line add up to 180°. Angles around a point add up to 360°."
                },
                {
                    "text": "Vertically opposite angles are equal."
                },
                {
                    "text": "On parallel lines: corresponding angles (F) are equal, alternate angles (Z) are equal, co-interior angles (C) add up to 180°."
                },
                {
                    "text": "Give a reason for every step, using the rule's words."
                }
