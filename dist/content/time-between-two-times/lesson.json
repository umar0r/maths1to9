        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "An hour has 60 minutes, not 100, so a calculator gives the wrong answer when the hour changes."
                },
                {
                    "text": "If both times are in the same hour, you can just take away the minutes."
                },
                {
                    "text": "If the hour changes, count up: hop to the next o'clock, skip the whole hours, then land on the end time."
                },
                {
                    "text": "Add up the jumps. If the minutes come to 60 or more, take 60 out to make an hour."
                },
                {
                    "text": "If the question wants the answer in minutes, count each hour as 60 minutes."
                }
            ]
        }
