        "intro": "",
        "questions": [
            {
                "type": "calculate",
                "input": "number",
                "prompt": "Find the gradient of the line.",
                "answer": "3/2",
                "graph": {
                    "p": 3,
                    "q": 2,
                    "a": [
                        1,
                        -2
                    ],
                    "b": [
                        5,
                        4
                    ]
                },
                "rules": [
                    {
                        "value": "6",
                        "feedback": "That’s the vertical change. Divide it by the horizontal change."
                    }
                ],
                "feedback": "Right. 6 ÷ 4 = 3/2, or 1.5."
            },
            {
                "type": "amirs-mistake",
                "input": "choice",
                "graph": {
                    "p": -2,
                    "q": 1,
                    "a": [
                        0,
                        5
                    ],
                    "b": [
                        3,
                        -1
                    ]
                },
                "marked": true,
                "prompt": "Amir says: 'The line goes 6 vertically and 3 horizontally, so its gradient is 2.' What has Amir missed?",
                "options": [
                    "The line goes down, so the vertical change is −6. The gradient is −2.",
                    "He should divide 3 by 6. The gradient is 1/2.",
                    "Nothing. The gradient is 2.",
                    "The vertical change is 5, so the gradient is 5/3."
                ],
                "answer": 0,
                "feedback": [
                    "Right. Read from left to right: the line falls, so the gradient is negative.",
                    "Amir divided the right way round: vertical ÷ horizontal. Look at which way the line goes.",
                    "Read the line from left to right. Does it go up or down?",
                    "5 is where the line crosses the y-axis. From (0, 5) down to (3, −1) is 6 units."
                ]
            },
            {
                "type": "two-triangles",
                "input": "choice",
                "prompt": "On the same straight line, one triangle goes up 2 for 4 across. A bigger one goes up 3 for 6 across. Do they give the same gradient?",
                "options": [
                    "Yes. 2 ÷ 4 and 3 ÷ 6 both equal 1/2.",
                    "No. The bigger triangle gives a bigger gradient.",
                    "Yes. Both equal 2."
                ],
                "answer": 0,
                "feedback": [
                    "Right. A straight line has the same gradient everywhere.",
                    "Both changes grew together. 3 ÷ 6 = 1/2, the same as 2 ÷ 4.",
                    "Divide the vertical change by the horizontal change: 2 ÷ 4, not 4 ÷ 2."
                ]
            },
            {
                "type": "read-scale",
                "input": "number",
                "prompt": "Find the gradient of the line.",
                "answer": "1/2",
                "graph": {
                    "p": 1,
                    "q": 2,
                    "a": [
                        -4,
                        1
                    ],
                    "b": [
                        4,
                        5
                    ],
                    "step": {
                        "x": 2,
                        "y": 1
                    }
                },
                "feedback": "Right. 4 ÷ 8 = 1/2."
            },
            {
                "type": "flat-line",
                "input": "number",
                "prompt": "Find the gradient of the line.",
                "answer": "0",
                "graph": {
                    "p": 0,
                    "q": 1,
                    "a": [
                        -4,
                        -2
                    ],
                    "b": [
                        4,
                        -2
                    ]
                },
                "fallback": "The line doesn’t go up or down, so its vertical change is 0.",
                "feedback": "Right. The line is flat, so its gradient is 0."
            }
