        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "Gradient = vertical change ÷ horizontal change."
                },
                {
                    "text": "Read from left to right: going down gives a negative gradient."
                },
                {
                    "text": "Count the units on the axes, not the squares."
