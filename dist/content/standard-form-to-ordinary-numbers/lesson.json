    "comparison": {
        "eyebrow": "Check",
        "title": "Check what you have learnt",
        "intro": "",
        "questions": [
            {
                "type": "sam",
                "prompt": "Sam says 2.4 × 10³ = 240. What is 2.4 × 10³ as an ordinary number?",
                "options": [
                    "2400",
                    "240",
                    "24 000",
                    "0.0024"
                ],
                "feedback": [
                    "Right. 10³ means three ×10 steps: 24, 240, 2400. Sam only did two.",
                    "That's Sam's answer. It's only two ×10 steps; 10³ means three.",
                    "That's four ×10 steps. 10³ means three.",
                    "That divides. A positive index means multiply by 10."
                ],
                "answer": 0,
                "title": "Sam's answer"
            },
            {
                "type": "aisha",
                "prompt": "Aisha says 6.8 × 10⁻² must be negative because the index has a minus sign. What is 6.8 × 10⁻² as an ordinary number?",
                "options": [
                    "0.068",
                    "−0.068",
                    "680",
                    "0.0068"
                ],
                "feedback": [
                    "Right. The minus sign means divide by 10 twice: 0.68, then 0.068. The answer is positive.",
                    "A negative index means divide. It doesn't make the number negative.",
                    "That multiplies. A negative index means divide by 10.",
                    "That's three ÷10 steps. The index is −2, so do two."
                ],
                "answer": 0,
                "title": "Aisha's answer"
            },
            {
                "type": "sand",
                "prompt": "A grain of sand has a mass of 3.05 × 10⁻⁴ g. What is this mass as an ordinary number of grams?",
                "options": [
                    "0.000305",
                    "0.00035",
                    "0.0000305",
                    "30 500"
                ],
                "feedback": [
                    "Right. Four ÷10 steps: 0.305, 0.0305, 0.00305, 0.000305.",
                    "Keep the 0 between the 3 and the 5. It holds a place.",
                    "That's five ÷10 steps. Four zeros after the point isn't the same as four steps.",
                    "That multiplies. A negative index means divide by 10."
                ],
                "answer": 0,
                "title": "A grain of sand"
            },
            {
                "type": "moon",
                "prompt": "The Moon is about 3.84 × 10⁵ km from the Earth. What is this distance as an ordinary number of kilometres?",
                "options": [
                    "384 000",
                    "38 400",
                    "3 840 000",
                    "0.0000384"
                ],
                "feedback": [
                    "Right. Five ×10 steps: 38.4, 384, 3840, 38 400, 384 000.",
                    "That's four ×10 steps. The index is 5, so do five.",
                    "That's six ×10 steps. The index is 5, so do five.",
                    "That divides. A positive index means multiply by 10."
                ],
                "answer": 0,
                "title": "To the Moon"
            }
        ],
        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "A positive index: multiply by 10 that many times."
                },
                {
                    "text": "A negative index: divide by 10 that many times. The answer is still positive."
                },
                {
                    "text": "An index of 0: the number stays the same."
                },
                {
                    "text": "Keep every digit in order, including zeros between digits."
                }
            ]
        }
    },
