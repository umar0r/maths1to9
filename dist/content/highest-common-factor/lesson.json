        "questions": [
            {
                "type": "hcf-prime-match",
                "prompt": "36 = 2 \u00d7 2 \u00d7 3 \u00d7 3, 60 = 2 \u00d7 2 \u00d7 3 \u00d7 5. Maya says the HCF is 6 because both contain a 2 and a 3. Is she right?",
                "options": [
                    "Yes. 6 divides both 36 and 60.",
                    "No. Both have two 2s, so the HCF is 2 \u00d7 2 \u00d7 3 = 12.",
                    "No. The HCF is 2 \u00d7 2 \u00d7 3 \u00d7 3 = 36.",
                    "No. The HCF is 2 \u00d7 2 \u00d7 3 \u00d7 3 \u00d7 5 = 180."
                ],
                "feedback": [
                    "6 is a common factor, but not the highest. Both numbers have two 2s.",
                    "Right. Both numbers share every prime in this product.",
                    "36 doesn't divide 60.",
                    "180 uses every factor. The HCF can't be bigger than either number."
                ],
                "answer": 1
            },
            {
                "type": "hcf-prime-match",
                "prompt": "24 = 2 \u00d7 2 \u00d7 2 \u00d7 3, 40 = 2 \u00d7 2 \u00d7 2 \u00d7 5. Sam puts 2, 2, 2 and 3 in the overlap. What should he do?",
                "options": [
                    "Take out the 3. HCF = 2 \u00d7 2 \u00d7 2 = 8.",
                    "Take out a 2. HCF = 2 \u00d7 2 \u00d7 3 = 12.",
                    "Nothing. HCF = 2 \u00d7 2 \u00d7 2 \u00d7 3 = 24.",
                    "Swap the 3 for the 5. HCF = 2 \u00d7 2 \u00d7 2 \u00d7 5 = 40."
                ],
                "feedback": [
                    "40 has no 3.",
                    "40 has three 2s too, and 12 doesn't divide 40.",
                    "24 doesn't divide 40. 40 has no 3.",
                    "40 doesn't divide 24. 24 has no 5."
                ],
                "answer": 0
            },
            {
                "type": "hcf-prime-match",
