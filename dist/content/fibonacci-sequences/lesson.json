        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "In a Fibonacci-type sequence, each term is the two terms before added together."
                },
                {
                    "text": "Move along one each time and add the last two terms."
                },
                {
                    "text": "The gaps keep changing, so there's no nth term like 3n − 1."
                },
                {
                    "text": "To find the 8th term, keep going until you reach position 8."
                }
            ]
        }
