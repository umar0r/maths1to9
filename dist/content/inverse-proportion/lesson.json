        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "Inverse proportion: two amounts always times to the same total. When one goes up, the other goes down."
                },
                {
                    "text": "Find the total job first: times. Then share it out: divide."
                },
                {
                    "text": "Double one and the other halves."
                },
                {
                    "text": "Fewer workers take longer. Don't halve the time when you halve the workers."
                },
                {
                    "text": "Ask: does more help? More chefs can't boil an egg faster."
                },
                {
                    "text": "You can't have part of a worker. Round up."
                }
            ]
        }
