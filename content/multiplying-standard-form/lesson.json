        "questions": [
            {
                "type": "sam",
                "prompt": "Sam works out (2 × 10³) × (3 × 10⁴) and gets 6 × 10¹². What is the correct answer in standard form?",
                "options": [
                    "6 × 10⁷",
                    "6 × 10¹²",
                    "5 × 10⁷",
                    "6 × 10¹"
                ],
                "feedback": [
                    "Right. 2 × 3 = 6 and 3 + 4 = 7. Sam multiplied the indices instead of adding them.",
                    "That's Sam's answer. He multiplied the indices: add them.",
                    "Multiply the front numbers: 2 × 3 = 6.",
                    "That subtracts the indices. Add them: 3 + 4 = 7."
                ],
                "answer": 0
            },
            {
                "type": "ella",
                "prompt": "Ella gets 10 × 10⁵. Which of these is the same number in standard form?",
                "options": [
                    "1 × 10⁶",
                    "10 × 10⁵",
                    "1 × 10⁵",
                    "1 × 10⁴"
                ],
                "feedback": [
                    "Right. 10 = 1 × 10, so the index goes up by 1.",
                    "The front number must be less than 10, so 10 isn't allowed.",
                    "Taking a 10 from the front adds one to the index: 10⁶.",
                    "Making the front smaller means the index goes up, not down."
                ],
                "answer": 0
            },
            {
                "type": "negative",
                "prompt": "Work out (6 × 10³) × (4 × 10⁻⁵). Give your answer in standard form.",
                "options": [
                    "2.4 × 10⁻¹",
                    "24 × 10⁻²",
                    "2.4 × 10⁻³",
                    "2.4 × 10⁹"
                ],
                "feedback": [
                    "Right. 6 × 4 = 24 and 3 + (−5) = −2, so 24 × 10⁻² = 2.4 × 10⁻¹.",
                    "Right value, but 24 is too big for the front. Take out a 10.",
                    "Taking a 10 from the front makes the index go up: −2 + 1 = −1.",
                    "Keep the minus sign: 3 + (−5) = −2."
                ],
                "answer": 0
            },
            {
                "type": "two-negative-check",
                "prompt": "Work out (5 × 10⁻³) × (3 × 10⁻⁴). Give your answer in standard form.",
                "options": [
                    "1.5 × 10⁻⁶",
                    "1.5 × 10⁻⁸",
                    "1.5 × 10¹³",
                    "8 × 10⁻⁷"
                ],
                "feedback": [
                    "Right. 5 × 3 = 15 and −3 + (−4) = −7, so 15 × 10⁻⁷ = 1.5 × 10⁻⁶.",
                    "Taking a 10 from the front makes the index go up: −7 + 1 = −6.",
                    "That multiplies the indices. Add them: −3 + (−4) = −7.",
                    "Multiply the front numbers: 5 × 3 = 15."
                ],
                "answer": 0
            }
        ],
        "summary": {
