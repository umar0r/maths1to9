        "summary": {
            "title": "What you've learned",
            "points": [
                {
                    "text": "To multiply decimals, take the points out and multiply.",
                    "example": "2.4 × 0.3 → 24 × 3 = 72"
                },
                {
                    "text": "Count the digits after the points, and put the same number back in the answer.",
                    "example": "2.4 × 0.3 = 0.72"
                },
                {
                    "text": "If you run out of digits, fill the gap with zeros.",
                    "example": "0.3 × 0.2 = 0.06"
                },
                {
                    "text": "When you divide by a whole number, the point goes straight up.",
                    "example": "8.4 ÷ 3 = 2.8"
                },
                {
                    "text": "To divide by a decimal, times both numbers by 10 until you’re dividing by a whole number.",
                    "example": "11.07 ÷ 0.9 = 110.7 ÷ 9 = 12.3"
                }
            ]
        }
    },
