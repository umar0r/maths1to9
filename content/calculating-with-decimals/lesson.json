        "summary": {
            "title": "What you've learned",
            "points": [
                {
                    "text": "To multiply decimals, count the digits after each point, then add them.",
                    "example": "0.24 × 0.003: 2 + 3 = 5"
                },
                {
                    "text": "Take the points out and work out the whole-number sum.",
                    "example": "24 × 3 = 72"
                },
                {
                    "text": "Move the point back that many digits. Put 0s in the gaps.",
                    "example": "72 → 0.00072"
                },
                {
                    "text": "To divide by a whole number, count the digits after the point.",
                    "example": "0.24 ÷ 3: 24 ÷ 3 = 8, so 0.08"
                },
                {
                    "text": "To divide by a decimal, count the digits after each point, then take them away.",
                    "example": "11.07 ÷ 0.9: 2 − 1 = 1, 1107 ÷ 9 = 123, so 12.3"
                }
            ]
        }
    },
