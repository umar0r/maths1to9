            "points": [
                {
                    "text": "Clock minutes only go up to 59. Then the clock moves on to the next hour."
                },
                {
                    "text": "Don't take away times like normal numbers when the hour changes."
                },
                {
                    "text": "Hop to the next o'clock. Skip whole hours. Land on the end time."
                },
                {
                    "text": "Add the jumps. Every 60 minutes make 1 hour."
                },
                {
                    "text": "If the question asks for minutes, each hour is 60 minutes."
                }
