        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "Speed is how far you go in each hour. 60 km/h means 60 km in each hour."
                },
                {
                    "text": "Distance = speed × time. Speed = distance ÷ time. Time = distance ÷ speed."
                },
                {
                    "text": "The unit gives you the triangle: km/h is km ÷ hours, so distance goes on top."
                },
                {
                    "text": "Make the times match. Divide minutes by 60 to get hours: 1 hour 15 minutes is 1.25 hours, not 1.15."
                },
                {
                    "text": "Write the unit on your answer."
                }
            ]
        }
