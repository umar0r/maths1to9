  "commonGotchas": [
    {
      "title": "Different letters do not match",
      "example": "3x + 2y",
      "text": "This cannot be simplified further."
    },
    {
      "title": "Different powers do not match",
      "example": "4x² + 3x",
      "text": "These are not like terms."
    },
    {
      "title": "Watch the minus sign",
      "example": "7m − 2m = 5m",
      "text": "The minus belongs to the 2m."
    },
    {
      "title": "A single letter means one of that letter",
      "example": "n = 1n",
      "text": "So 7n − n = 6n."
    },
    {
      "title": "Collect constants separately",
      "example": "4x + 7 + 3x − 2 = 7x + 5",
      "text": "The numbers and the letter terms are collected separately."
    }
  ],
