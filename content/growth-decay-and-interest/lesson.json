            "title": "What you have learnt",
            "points": [
                {
                    "text": "Interest is extra money added to savings."
                },
                {
                    "text": "Simple interest: you get the same amount every year."
                },
                {
                    "text": "Compound interest: times by the multiplier once for each year, like 1000 × 1.05³."
                },
                {
                    "text": "Interest = total − the money you put in."
                },
                {
                    "text": "Losing value works the same way: 20% off each year is × 0.8 each year."
                }
            ]
        }
