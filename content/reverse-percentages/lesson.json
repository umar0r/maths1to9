        "summary": {
            "title": "What you have learnt",
            "points": [
                {
                    "text": "The percentage in a question is a percentage of the amount before the change. That amount is 100%."
                },
                {
                    "text": "Going up: add the percentage to 100%. Going down: take it away from 100%. That tells you what percentage you have now."
                },
                {
                    "text": "Find 1% by dividing, then times by 100. Or divide by the multiplier: £60 ÷ 0.8 = £75."
                },
                {
                    "text": "Don't add the percentage back on. 20% of £60 is not the same as 20% of £75."
                },
                {
                    "text": "Check your answer: do the change forwards. You should get back to the amount in the question."
                }
            ]
        }
    },
